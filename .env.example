# CertiVerify Enterprise - Environment Variables Example
ENV=development
DEBUG=true

# Auth & Email Verification
# Set to false to bypass email OTP verification for development/testing
# Defaults to true in production
EMAIL_VERIFICATION_REQUIRED=false

# Database Configuration & Pool Settings
DATABASE_URL=postgresql+asyncpg://certiverify:certiverify@localhost:5432/certiverify
DB_POOL_PRE_PING=true
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# Security / JWT & Sessions
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Dev-only non-expiring session flag (refused in production)
DEV_LONG_LIVED_SESSION=false
DEV_SESSION_EXPIRE_MINUTES=1440

# Verification Job Telemetry & Lifecycle
JOB_STALE_TIMEOUT_SECONDS=120
JOB_MAX_RETRIES=3

# Server Binding (Host & Port)
HOST=127.0.0.1
PORT=8000

# Health & Readiness Probe Configuration
HEALTH_PATH=/health
READINESS_PATH=/health/ready
HEALTH_CHECK_TIMEOUT_SECONDS=3.0

# Startup & Component Health Timeouts
OCR_WARMUP_ENABLED=true
OCR_WARMUP_TIMEOUT_SECONDS=30.0
BLOCKCHAIN_CHECK_TIMEOUT_SECONDS=3.0
SIGNING_KEY_CHECK_TIMEOUT_SECONDS=1.0

# CORS Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional regex pattern for dev origins (leave empty to use default local dev regex in dev mode)
CORS_ORIGIN_REGEX=

# SMTP Email (Only required if EMAIL_VERIFICATION_REQUIRED=true in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@certiverify.ai

# QR Verification Configuration (Module 1)
# Comma-separated list of trusted domain names for QR validation (e.g. "university.edu,tndge.org,gov.in")
# Leave empty to classify domains neutrally without hard rejection.
QR_TRUSTED_DOMAINS=
# Set to true to enable automated live HTTP check against the decoded URL
QR_LIVE_CHECK_ENABLED=false
# Timeout in seconds for live URL check
QR_LIVE_CHECK_TIMEOUT_SECONDS=5.0
# Fuzzy match threshold (0.0 to 1.0) for validating OCR names/registration numbers on live portal page
QR_FUZZY_MATCH_THRESHOLD=0.70

# Blockchain Verification Configuration (Module 2)
# Provider choice: "none" (not configured) | "local_ledger" (dev/demo file/table) | "evm" (smart contract read)
BLOCKCHAIN_PROVIDER=none
# EVM / JSON-RPC endpoint
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Smart contract address for CertificateRegistry
BLOCKCHAIN_CONTRACT_ADDRESS=
# Path to CertificateRegistry ABI JSON file (leave blank for default auto-discovery)
BLOCKCHAIN_ABI_PATH=
# Network identifier
BLOCKCHAIN_NETWORK_NAME=localhost
# Required confirmations
BLOCKCHAIN_CONFIRMATION_COUNT=1
# Timeout in seconds for blockchain RPC calls
BLOCKCHAIN_TIMEOUT_SECONDS=5.0
# Maximum retries on transient RPC failures
BLOCKCHAIN_MAX_RETRIES=2
# Exponential backoff base in seconds
BLOCKCHAIN_RETRY_BACKOFF_SECONDS=0.5
# Path for local append-only ledger file when using BLOCKCHAIN_PROVIDER=local_ledger
BLOCKCHAIN_LOCAL_LEDGER_PATH=data/local_blockchain_ledger.json

# Tampering & Forgery Detection Configuration (Module 3)
# JSON dictionary of weights for pluggable checks (must sum to 1.0)
TAMPERING_CHECK_WEIGHTS={"ela": 0.25, "pdf_metadata_structure": 0.20, "copy_move": 0.20, "noise_inconsistency": 0.15, "font_layout": 0.10, "image_quality": 0.10}
# Quality setting for Error Level Analysis JPEG re-save (default: 90)
TAMPERING_ELA_QUALITY=90
# Output directory for saving ELA heatmap visualizations
TAMPERING_HEATMAP_OUTPUT_DIR=uploads/ela_heatmaps
# Risk level threshold bands (JSON mapping of max score threshold for each level)
TAMPERING_RISK_BANDS={"LOW": 25.0, "MEDIUM": 60.0, "HIGH": 100.0}
# Comma-separated list of suspicious producer/creator tools to flag in PDF/image metadata
TAMPERING_SUSPICIOUS_PRODUCERS=photoshop,canva,illustrator,gimp,inkscape,coreldraw,paint.net,affinity,pixelmator,pdfedit
# Confidence cap (0-100) when only metadata anomalies are detected without image manipulation
TAMPERING_METADATA_ONLY_CONFIDENCE_CAP=40.0
# Minimum matched keypoint clusters for copy-move detection
TAMPERING_COPY_MOVE_MIN_MATCHES=12
# Normalized ELA anomaly threshold for flagging localized manipulation
TAMPERING_ELA_ANOMALY_THRESHOLD=18.0

# Duplicate Detection Configuration (Module 4)
# Allow cross-organization duplicate matching (true/false, default: false)
DUPLICATE_CROSS_ORG_ALLOWED=false
# Exclude sibling documents uploaded in the same batch group_id (true/false, default: false)
DUPLICATE_EXCLUDE_SAME_GROUP=false
# Maximum Hamming distance (0-64 bits) for perceptual hash match (pHash/dHash)
DUPLICATE_PERCEPTUAL_MAX_DISTANCE=10
# Minimum fuzzy string similarity (0-100) for matching student names in identity check
DUPLICATE_FUZZY_NAME_THRESHOLD=85.0
# Minimum fuzzy field similarity (0-100) for general field similarity fallback
DUPLICATE_FUZZY_FIELD_THRESHOLD=85.0
# Perceptual hash grid dimension (default: 8 for 64-bit hash)
DUPLICATE_PERCEPTUAL_HASH_SIZE=8

# AI Fraud Analysis Configuration (Module 5)
# Nominal weights for the 8 signals (summing to 1.0)
FRAUD_WEIGHT_OCR_ACCURACY=0.15
FRAUD_WEIGHT_COMPARISON=0.15
FRAUD_WEIGHT_QR=0.10
FRAUD_WEIGHT_BLOCKCHAIN=0.15
FRAUD_WEIGHT_TAMPERING=0.20
FRAUD_WEIGHT_DUPLICATE=0.10
FRAUD_WEIGHT_METADATA_INTEGRITY=0.05
FRAUD_WEIGHT_IMAGE_QUALITY=0.10

# Hard-floor override risk thresholds
FRAUD_OVERRIDE_BLOCKCHAIN_MISMATCH_FLOOR=0.85
FRAUD_OVERRIDE_DIFFERENT_OWNER_DUPLICATE_FLOOR=0.85
FRAUD_OVERRIDE_CONFLICT_FLOOR=0.90
FRAUD_OVERRIDE_TAMPERING_THRESHOLD=70.0
FRAUD_OVERRIDE_TAMPERING_FLOOR=0.75
FRAUD_OVERRIDE_QR_INVALID_FLOOR=0.65

# Trust Score Configuration (Module 6)
# Score bands (High >= 80, Medium >= 50, Low < 50)
TRUST_SCORE_BAND_HIGH=80.0
TRUST_SCORE_BAND_MEDIUM=50.0

# Nominal weights for the 8 positive trust components
TRUST_WEIGHT_OCR=0.15
TRUST_WEIGHT_COMPARISON=0.10
TRUST_WEIGHT_QR=0.15
TRUST_WEIGHT_BLOCKCHAIN=0.15
TRUST_WEIGHT_TAMPERING=0.15
TRUST_WEIGHT_DUPLICATE=0.10
TRUST_WEIGHT_FRAUD=0.10
TRUST_WEIGHT_IMAGE_QUALITY=0.10

# Final Prediction Configuration (Module 7)
PREDICTION_MIN_COVERAGE_FOR_VERDICT=0.50
PREDICTION_GENUINE_TRUST_MIN=80.0
PREDICTION_GENUINE_FRAUD_MAX=0.25
PREDICTION_SUSPICIOUS_TRUST_MIN=50.0
PREDICTION_SUSPICIOUS_FRAUD_MAX=0.60
PREDICTION_ACTION_GENUINE="Accept certificate — credential verified against institutional and forensic standards."
PREDICTION_ACTION_SUSPICIOUS="Manual review required — escalate to admissions/compliance officer for secondary inspection."
PREDICTION_ACTION_FAKE="Reject certificate — evidence indicates duplicate collision, tampering, or cryptographic forgery."
PREDICTION_ACTION_INCONCLUSIVE="Request original hardcopy or direct verification from the issuing institution (insufficient evidence coverage / inconclusive verdict)."

# PDF Report Generation Configuration (Module 8)
# Name of auditing organization displayed in report header and watermark
REPORT_ORG_NAME="CertiVerify Enterprise"
# Optional filesystem path to institution/org logo image (PNG/JPEG)
REPORT_LOGO_PATH=
# Running footer text on each page of verification report
REPORT_FOOTER_TEXT="Confidential Verification Report — CertiVerify Enterprise Integrity Engine"
# Output directory for saving generated PDF reports
REPORT_OUTPUT_DIR="uploads/reports"
# Page size: "A4" or "LETTER"
REPORT_PAGE_SIZE="A4"
# Public verification URL template for QR code embedding
REPORT_VERIFY_URL_TEMPLATE="http://localhost:3000/verify/{verification_id}"
# Cryptographic HMAC-SHA256 signing key (falls back to SECRET_KEY in development, required in production)
REPORT_SIGNING_KEY=

